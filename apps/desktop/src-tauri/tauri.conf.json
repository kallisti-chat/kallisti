{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kallisti",
  "version": "0.14.1",
  "identifier": "chat.kallisti.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @kallisti/web dev",
    "beforeBuildCommand": "pnpm --filter @kallisti/web build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Kallisti", "width": 1280, "height": 800, "minWidth": 380, "backgroundThrottling": "disabled" }],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* https: wss: http://localhost:* ws://localhost:*; img-src 'self' blob: data: https: http://localhost:*; media-src 'self' blob: https: http://localhost:*; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "infoPlist": "Info.plist", "entitlements": "Entitlements.plist" },
    "linux": {
      "appimage": { "bundleMediaFramework": true },
      "deb": { "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-libav"] },
      "rpm": { "depends": ["gstreamer1-plugins-good", "gstreamer1-plugin-libav"] }
    }
  }
}
