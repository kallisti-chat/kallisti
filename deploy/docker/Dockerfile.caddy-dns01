FROM docker.io/library/caddy:2.11.7-builder-alpine AS builder
RUN xcaddy build v2.11.7 --with github.com/caddy-dns/cloudflare@v0.2.4

FROM docker.io/library/caddy:2.11.7-alpine
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
# Caddy answers on its admin endpoint (localhost only). It runs as root
# like the official image: its existing storage belongs to root, and
# cert-sync reads the certificate there (Kubernetes runs it as 1000).
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
  CMD wget -q -O /dev/null http://127.0.0.1:2019/config/ || exit 1
